---
const icons = import.meta.glob("./*.astro", { eager: true }) as Record<string, { default: any }>;

type Props = {
  icon: string;
  class?: string;
};

const { icon } = Astro.props;

if (icon === "Provider") {
  throw new Error(`Invalid Icon "[${icon}]" passed to provider. This name is disabled by default.`);
}

let IconComponent = Object.values(icons).find((iconFile) => {
  return iconFile.default && iconFile.default.name === icon;
});

if (!IconComponent) {
  throw new Error(`Invalid Icon "[${icon}]" passed to provider. Check your starlight config.`);
}
---
<IconComponent.default />
